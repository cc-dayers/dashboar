{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "report.v4.schema.json",
    "title": "PR Review Report - Schema v4",
    "description": "Frozen schema for report.json files produced by review-report-builder.mjs at schemaVersion '4'.",
    "type": "object",
    "required": ["schemaVersion", "reviews"],
    "additionalProperties": false,
    "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "type": "string", "const": "4" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "period": { "type": "string" },
        "reviews": { "type": "array", "items": { "$ref": "#/$defs/ReviewEntry" } }
    },
    "$defs": {
        "ReviewEntry": {
            "type": "object",
            "required": ["id", "prNumber", "prTitle", "repository", "reviewedAt", "timeToReviewMs", "accuracyRating", "result", "hats", "tokensUsed", "estimatedCostUsd"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "pattern": "^pr-\\d+$" },
                "prNumber": { "type": "integer", "minimum": 1 },
                "prTitle": { "type": "string" },
                "repository": { "type": "string" },
                "branch": { "type": "string" },
                "author": { "type": "string" },
                "reviewedAt": { "type": "string", "format": "date-time" },
                "timeToReviewMs": { "type": "integer", "minimum": 0 },
                "accuracyRating": { "type": "number", "minimum": 0, "maximum": 100 },
                "result": { "type": "string", "enum": ["approved", "changes-requested", "commented"] },
                "hats": { "type": "array", "items": { "type": "string" } },
                "hatDetails": { "type": "array", "items": { "$ref": "#/$defs/HatDetail" } },
                "tokensUsed": { "type": "integer", "minimum": 0 },
                "estimatedCostUsd": { "type": "number", "minimum": 0 },
                "aicCreditsUsed": { "type": "integer", "minimum": 1 },
                "copilotBillingUsage": { "$ref": "#/$defs/CopilotBillingUsage" },
                "model": { "type": "string" },
                "provider": { "type": "string", "enum": ["azure", "copilot", "codex"] },
                "modelsUsed": { "type": "array", "items": { "$ref": "#/$defs/ModelUsageEntry" } },
                "notes": { "type": "string" },
                "jiraTicket": { "$ref": "#/$defs/JiraTicketRef" },
                "downstreamImpact": { "$ref": "#/$defs/DownstreamImpactSummary" }
            }
        },
        "CopilotBillingUsage": {
            "type": "object",
            "required": ["value", "unit"],
            "additionalProperties": false,
            "properties": {
                "value": { "type": "integer", "minimum": 1 },
                "unit": { "type": "string", "enum": ["ai-credits", "premium-requests"] }
            }
        },
        "JiraTicketRef": {
            "type": "object",
            "required": ["key"],
            "additionalProperties": false,
            "properties": {
                "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-\\d+$" },
                "title": { "type": "string" }
            }
        },
        "HatDetail": {
            "type": "object",
            "required": ["name", "findings"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "findings": { "type": "array", "items": { "$ref": "#/$defs/HatFinding" } }
            }
        },
        "HatFinding": {
            "type": "object",
            "required": ["type", "severity", "description"],
            "additionalProperties": false,
            "properties": {
                "type": { "type": "string" },
                "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
                "description": { "type": "string" },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 }
            }
        },
        "ModelUsageEntry": {
            "type": "object",
            "required": ["provider", "model"],
            "additionalProperties": false,
            "properties": {
                "label": { "type": "string" },
                "source": { "type": "string" },
                "provider": { "type": "string", "enum": ["azure", "copilot", "codex"] },
                "model": { "type": "string" },
                "tier": { "type": "string" },
                "reasoningEffort": { "type": "string" },
                "attemptedModels": { "type": "array", "items": { "type": "string" } },
                "attemptedReasoningEfforts": { "type": "array", "items": { "type": "string" } },
                "attemptedConfigurations": { "type": "array", "items": { "type": "string" } }
            }
        },
        "DownstreamImpactSummary": {
            "type": "object",
            "required": ["triggered", "contractCount", "referenceCount", "hasBreakingChanges"],
            "additionalProperties": false,
            "properties": {
                "triggered": { "type": "boolean" },
                "contractCount": { "type": "integer", "minimum": 0 },
                "referenceCount": { "type": "integer", "minimum": 0 },
                "hasBreakingChanges": { "type": "boolean" },
                "riskClasses": { "type": "array", "items": { "type": "string" } },
                "affectedAreas": { "type": "array", "items": { "type": "string" } },
                "validationCount": { "type": "integer", "minimum": 0 },
                "warningCount": { "type": "integer", "minimum": 0 }
            }
        }
    }
}
